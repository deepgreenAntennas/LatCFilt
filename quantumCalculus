import heapq
import math

# Quantum calculus utils: q-number and q-factorial ratio
def q_number(n, q):
   return (1.0 - math.pow(q, n)) / (1.0 - q)

def q_factorial_ratio(n, q):  # [n]_q = [n]_q! / [n-1]_q!
   return q_number(n, q)

# Generate and print conversion ratio table
def print_quantum_table(q, max_n):
   print(f"\n=== Quantum Calculus Conversion Ratio Table (q = {q:.3f}) ===")
   print(f"{'n':<8} {'[n]_q Ratio':<12}")
   print("----------------------------------------")
   for n in range(1, max_n + 1):
       ratio = q_factorial_ratio(n, q)
       print(f"{n:<8} {ratio:.6f}")

