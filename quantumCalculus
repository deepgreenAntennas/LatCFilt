class AdventureGraph:
   def __init__(self, n):
       self.num_nodes = n
       self.adj = [[] for _ in range(n)]  # List of lists of (to, cost)

   def add_edge(self, from_, to, cost):
       self.adj[from_].append((to, cost))

   # Heuristic for A*: Extrapolated distance using quantum ratio (q-factor)
   def heuristic(self, from_, goal, q):
       dist = abs(from_ - goal)  # Manhattan-like distance
       # Extrapolate with q-ratio: simulates quantum scaling for future uncertainty
       return dist * math.pow(q, dist) * (1.0 + 0.1 * dist)  # Simple extrapolation

   # A* pathfinding with extrapolation
   def find_path(self, start, goal, q):
       g_score = [math.inf] * self.num_nodes
       f_score = [math.inf] * self.num_nodes
       came_from = [-1] * self.num_nodes
       visited = [False] * self.num_nodes

       g_score[start] = 0.0
       f_score[start] = self.heuristic(start, goal, q)

       pq = []
       heapq.heappush(pq, (f_score[start], start))

       while pq:
           _, current = heapq.heappop(pq)
           if visited[current]:
               continue
           visited[current] = True

           if current == goal:
               # Reconstruct path
               path = []
               at = goal
               while at != -1:
                   path.append(at)
                   at = came_from[at]
               path.reverse()
               return path

           for to, cost in self.adj[current]:
               tentative_g = g_score[current] + cost * (1.0 + to * 0.1)  # Scale by headway proxy (node id as proxy)
               if tentative_g < g_score[to]:
                   came_from[to] = current
                   g_score[to] = tentative_g
                   f_score[to] = tentative_g + self.heuristic(to, goal, q)
                   heapq.heappush(pq, (f_score[to], to))

       return []  # No path

